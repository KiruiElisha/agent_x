# Where the bridge listens. Keep it on loopback and let Frappe reach it locally;
# exposing this port to the internet exposes the linked WhatsApp number.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Shared secret Frappe sends as "Authorization: Bearer <token>".
# This is the master token. Issue a separate token per client from AgentX Settings.
# Generate with: openssl rand -hex 32
BRIDGE_API_TOKEN=

# Baileys credentials live here. Back this up: losing it means re-scanning the QR.
BRIDGE_SESSION_DIR=./sessions

# Fallback webhook for a single local site. Other sites register their own URL
# when they connect, so this does not have to point at every tenant.
BRIDGE_WEBHOOK_URL=https://your-site.example.com/api/method/agent_x.core.webhook.receive
# Signs the fallback webhook. Each site can send its own secret when it registers.
# Required: Frappe refuses unsigned events. The fallback matches Webhook Secret
# in AgentX Settings when a session has not registered its own.
# openssl rand -hex 32
BRIDGE_WEBHOOK_SECRET=

# The public page can create a client without the master token. Set to 0 to
# leave that to the operator. BRIDGE_MAX_TENANTS caps how many can sign up.
BRIDGE_SIGNUP=1
BRIDGE_MAX_TENANTS=200
# Signing in with this address opens the admin panel. Every other address
# opens that client's page.
# BRIDGE_ADMIN_EMAIL=you@company.com

# Optional relay. When this is empty, the bridge sends from its own mail
# server using the domain on BRIDGE_PUBLIC_URL (or BRIDGE_MAIL_DOMAIN) and
# the recipient's mail server. Port 25 must be allowed outbound for that.
# BRIDGE_SMTP_HOST=
# BRIDGE_SMTP_PORT=587
# BRIDGE_SMTP_USER=
# BRIDGE_SMTP_PASSWORD=
# BRIDGE_SMTP_FROM=
# BRIDGE_PUBLIC_URL=
# Incoming mail is accepted for BRIDGE_MAIL_DOMAIN. The listener stays on
# loopback unless you set BRIDGE_MAIL_HOST=0.0.0.0 and point an MX record here.
# BRIDGE_MAIL_HOST=127.0.0.1
# BRIDGE_MAIL_PORT=2525
# BRIDGE_MAIL_DOMAIN=whatsapp.site.com

BRIDGE_LOG_LEVEL=info

# Voice notes are fetched at arrival and inlined in the webhook, because Baileys
# can only decrypt them while it still holds the message. Larger ones are skipped.
BRIDGE_INLINE_AUDIO_MAX_MB=8
